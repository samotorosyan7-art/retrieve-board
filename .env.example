NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Optional — task-assignment emails via Resend (leave blank to disable). Server-only: add to Vercel, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on a domain verified in Resend (defaults to onboarding@resend.dev, which only reaches the Resend account owner)
RESEND_FROM=Retrieve Group <notifications@your-verified-domain.com>

# Needed for invitation emails when an admin adds a team member (/api/notify/member-invite) and for the reminders below.
# Supabase → Project Settings → API Keys → secret / service_role. Server-only: add to Vercel as a plain (non-NEXT_PUBLIC_)
# variable. It bypasses RLS — never commit it or expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
# Optional — daily "due within 48h" reminder emails (/api/cron/deadline-reminders, scheduled in vercel.json).
# CRON_SECRET is any long random string; Vercel sends it to the cron route automatically.
# CRON_SECRET=
# Link used in emails (defaults to the site the request came from). Also read by scripts/invite-team.mjs.
# APP_URL=https://your-app.vercel.app
