NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Optional — task-assignment emails via Resend (leave blank to disable). Server-only: add to Vercel, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on a domain verified in Resend (defaults to onboarding@resend.dev, which only reaches the Resend account owner)
RESEND_FROM=Retrieve PM <notifications@your-verified-domain.com>

# Optional — daily "due within 48h" reminder emails (/api/cron/deadline-reminders, scheduled in vercel.json).
# Server-only: add to Vercel as plain (non-NEXT_PUBLIC_) variables. CRON_SECRET is any long random string;
# Vercel sends it to the cron route automatically. The service role key bypasses RLS — never commit it or expose it to the browser.
# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# Link used in emails (defaults to the site the request came from). Also read by scripts/invite-team.mjs.
# APP_URL=https://your-app.vercel.app
